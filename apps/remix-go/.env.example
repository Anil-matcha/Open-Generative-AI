# Remix Go Environment Configuration
# Copy this file to .env.local and update with your settings

# API Configuration
REACT_APP_API_BASE_URL=http://localhost:1340
REACT_APP_WL_DOMAIN=videoremix.io

# Supabase Configuration (for media storage)
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key

# Authentication (demo mode)
# In demo mode, authentication is bypassed
REACT_APP_DEFAULT_USER_ID=demo-user