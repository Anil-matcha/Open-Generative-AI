# =============================================================================
# VIDECO PLATFORM - ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env.local and fill in your actual values
# DO NOT commit .env.local to version control

# =============================================================================
# DATABASE & SUPABASE
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# =============================================================================
# STRIPE PAYMENT PROCESSING
# =============================================================================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOKS_SECRET=whsec_your_stripe_webhook_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
NEXT_PUBLIC_STRIPE_PRICING_TABLE_ID=prctbl_your_stripe_pricing_table_id

# Stripe Plan IDs
NEXT_PUBLIC_PLAN_GROWTH_TRIAL=price_your_growth_trial_plan_id
NEXT_PUBLIC_PLAN_LITE_MONTH=price_your_lite_monthly_plan_id
NEXT_PUBLIC_PLAN_LITE_YEAR=price_your_lite_yearly_plan_id
NEXT_PUBLIC_PLAN_GROWTH_MONTH=price_your_growth_monthly_plan_id
NEXT_PUBLIC_PLAN_GROWTH_YEAR=price_your_growth_yearly_plan_id
NEXT_PUBLIC_PLAN_SCALE_MONTH=price_your_scale_monthly_plan_id
NEXT_PUBLIC_PLAN_SCALE_YEAR=price_your_scale_yearly_plan_id

# =============================================================================
# EMAIL SERVICE (BREVO)
# =============================================================================
BREVO_API_KEY=xkeysib-your_brevo_api_key
BREVO_SECRET_KEY=your_brevo_secret_key

# =============================================================================
# MEDIA & CLOUD SERVICES
# =============================================================================
# Cloudinary for image/video processing
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Mux for video streaming
MUX_TOKEN_ID=your_mux_token_id
MUX_TOKEN_SECRET=your_mux_token_secret

# Sync.so for AI video processing
SYNC_API_KEY=sk_your_sync_api_key

# =============================================================================
# THIRD-PARTY INTEGRATIONS
# =============================================================================
# Zapier integration
NEXT_PUBLIC_ZAPIER_CLIENT_ID=your_zapier_client_id

# File upload service
NEXT_PUBLIC_UPLOAD_CLIENT_KEY=your_upload_client_key

# User onboarding analytics
NEXT_PUBLIC_USETIFUL_TOKEN=your_usetiful_token

# Partnero affiliate tracking
PARTNERO_API_KEY=your_partnero_api_key

# =============================================================================
# SUPPORT & ANALYTICS
# =============================================================================
# Crisp chat widget
NEXT_PUBLIC_CRISP_WEBSITE_ID=your_crisp_website_id

# ProductLift feedback widgets
NEXT_PUBLIC_PRODUCTLIFT_SIDEBAR_ID=your_productlift_sidebar_id
NEXT_PUBLIC_PRODUCTLIFT_WIDGET_ID=your_productlift_widget_id

# PostHog analytics (optional)
NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_key

# =============================================================================
# INTERNAL API SECURITY
# =============================================================================
VIDECO_SECRET_KEY=your_internal_videco_secret_key
FEEDBACK_SECRET_KEY=your_feedback_system_secret_key
WEBHOOK_SECRET=whsec_your_general_webhook_secret

# =============================================================================
# SITE CONFIGURATION
# =============================================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Calendar booking URL
NEXT_PUBLIC_CALENDAR_BOOKING_URL=https://calendar.google.com/your_booking_url

# Slack community invite
NEXT_PUBLIC_SLACK_INVITE_URL=https://join.slack.com/your_slack_invite

# =============================================================================
# OPTIONAL SERVICES
# =============================================================================
# OpenAI for Supabase Studio AI features
OPENAI_API_KEY=sk-your_openai_api_key

# Twilio for SMS authentication (if using)
SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=your_twilio_auth_token

# AWS S3 for OrioleDB storage (if using)
S3_HOST=your_s3_bucket_host
S3_REGION=your_s3_region
S3_ACCESS_KEY=your_s3_access_key
S3_SECRET_KEY=your_s3_secret_key

# =============================================================================
# DEVELOPMENT
# =============================================================================
NODE_ENV=development
