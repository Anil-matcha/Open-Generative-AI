# Cloud providers
GEMINI_API_KEY=
# Optional: override the Google Generative Language API base URL
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Local Ollama server
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TEXT_MODEL=llama3.2

# Local ComfyUI server
COMFYUI_BASE_URL=http://127.0.0.1:8188
# Export a ComfyUI API-format workflow as JSON and set it here.
COMFYUI_IMAGE_WORKFLOW_JSON=
COMFYUI_VIDEO_WORKFLOW_JSON=
# Optional: node id and input name used to replace the positive prompt.
COMFYUI_PROMPT_NODE_ID=
COMFYUI_PROMPT_INPUT=text
COMFYUI_TIMEOUT_MS=900000

# Existing MuAPI integration remains supported by the existing app routes.
# MUAPI_API_KEY=
