# Cloud providers
GEMINI_API_KEY=
# Optional: override the Google Generative Language API base URL
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Local Ollama server
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TEXT_MODEL=llama3.2

# Existing MuAPI integration remains supported by the existing app routes.
# MUAPI_API_KEY=
