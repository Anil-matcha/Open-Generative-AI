# ============================================
# Open-Higgsfield-AI - Environment Configuration
# Copy this to .env and fill in your values
# ============================================

# ---------------
# Supabase Configuration
# ---------------
# Get these from your Supabase project dashboard
# https://supabase.com/dashboard/project/<your-project>/settings/api
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ---------------
# AI Services (Backend Only - Do NOT expose in browser)
# ---------------
# OpenAI API Key (for script generation, personalization)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# MuAPI API Key (for video generation, workflows)
# Get from: https://www.muapi.ai/dashboard
MUAPI_API_KEY=your_muapi_api_key_here
MUAPI_API_URL=https://api.muapi.ai

# ---------------
# Stripe Configuration (Backend Only)
# ---------------
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# ---------------
# Public Configuration
# ---------------
# Your public site URL (for public video pages, webhooks)
PUBLIC_SITE_URL=https://your-site.netlify.app

# ---------------
# Optional Overrides
# ---------------
# Override default OpenAI model (defaults to gpt-4o)
# VITE_LLM_MODEL=gpt-4o

# Custom OpenAI API URL (for proxies)
# VITE_OPENAI_API_URL=https://api.openai.com/v1/chat/completions

# ---------------
# Netlify Function Variables
# ---------------
# MuAPI webhook URL (for video completion callbacks)
MUAPI_WEBHOOK_URL=https://your-site.netlify.app/muapi-webhook

# ---------------
# Development Only
# ---------------
# Supabase Service Role Key (for admin operations in Edge Functions)
# Already set above as SUPABASE_SERVICE_ROLE_KEY
