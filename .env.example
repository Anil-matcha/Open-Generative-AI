# Required in deployed Next.js environments. Generate with: openssl rand -base64 48
UPLOAD_PROXY_TICKET_SECRET=replace-with-at-least-32-random-characters

# Upload proxy policy (defaults shown).
UPLOAD_PROXY_TICKET_TTL_SECONDS=300
UPLOAD_PROXY_MAX_BYTES=52428800
UPLOAD_PROXY_RATE_LIMIT=20
UPLOAD_PROXY_RATE_WINDOW_MS=60000
# Optional exact HTTPS hostnames in addition to approved amazonaws.com S3 hosts.
UPLOAD_PROXY_ALLOWED_HOSTS=

# Content safety is enforced unless explicitly set to audit or off.
CONTENT_SAFETY_MODE=enforce
# Optional comma-separated terms added to the built-in high-risk rules.
CONTENT_SAFETY_BLOCKED_TERMS=
# Electron/Vite builds use these compile-time equivalents and also default to enforcement.
VITE_CONTENT_SAFETY_MODE=enforce
VITE_CONTENT_SAFETY_BLOCKED_TERMS=
VITE_UPLOAD_PROXY_MAX_BYTES=52428800

# Maximum body size accepted by authenticated API proxy routes.
MUAPI_PROXY_MAX_BODY_BYTES=52428800

# Private Creator Studio GitHub authentication.
# Register a separate GitHub OAuth app for each environment and use an exact callback URL.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=https://your-exact-host.example/api/auth/github/callback
# Generate independently with: openssl rand -base64 48
CREATOR_SESSION_SECRET=replace-with-at-least-32-random-characters
# Pin the immutable numeric user ID when known. A login allowlist is required when no ID is set.
CREATOR_GITHUB_ALLOWED_USER_IDS=
CREATOR_GITHUB_ALLOWED_LOGINS=lalambert1982-eng
CREATOR_SESSION_TTL_SECONDS=28800
CREATOR_STUDIO_RATE_LIMIT=5
CREATOR_STUDIO_STATUS_RATE_LIMIT=120
CREATOR_STUDIO_RATE_WINDOW_MS=60000

# Anthropic creative assistant (server-side only).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_API_VERSION=2023-06-01
ANTHROPIC_MAX_TOKENS=6000
# Optional override for the private creative-director system prompt.
ANTHROPIC_ASSISTANT_SYSTEM_PROMPT=

# OpenAI image generation (server-side only).
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
# low is the safest default for inexpensive test generations.
OPENAI_IMAGE_DEFAULT_QUALITY=low

# ElevenLabs text-to-speech (server-side only).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# HeyGen avatar video (server-side only).
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=

# Runway cinematic video (server-side only).
RUNWAY_API_KEY=
RUNWAY_VIDEO_MODEL=gen4.5
RUNWAY_API_VERSION=2024-11-06
