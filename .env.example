# AI Prompt Engine - Environment Configuration
# Copy this file to .env and fill in your values

# OpenAI API Key for AI Prompt Engine Ultra Enhancement
# Get your key at: https://platform.openai.com/api-keys
# The Ultra Enhance button uses GPT-4o for AI-powered prompt enhancement
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Override default model (defaults to gpt-4o)
# VITE_LLM_MODEL=gpt-4o

# Optional: Custom OpenAI API URL (for proxies)
# VITE_OPENAI_API_URL=https://api.openai.com/v1/chat/completions

# Supabase Configuration for CutAI Storyboarding
# Get these from your Supabase project dashboard
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# MuAPI Configuration (existing)
VITE_MUAPI_URL=https://api.muapi.ai
MUAPI_API_KEY=your_muapi_api_key_here

# Other API Keys
ANTHROPIC_API_KEY=your_anthropic_key_here
MORPH_API_KEY=your_morph_api_key_here